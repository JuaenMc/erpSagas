# PostgreSQL Connection (Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# API Port & Security
PORT=3001
ERP_INTERNAL_API_KEY="random_32_characters_secret_api_key_here"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,capacitor://localhost,https://localhost"

# Neon Auth & Project Settings
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# AI Studio / Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3002"

